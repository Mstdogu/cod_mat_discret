#include <stdio.h>
#include <stdlib.h>

/* graf pastrat intern ca lista de adiacenta: adj[i] are deg[i] vecini (i=1..n) */

int n = 0;
int **adj = NULL;
int *deg = NULL;
int ok = 0;

/* ====== curata graful ====== */
void clearGraf() {
    int i;
    if (adj) {
        for (i = 1; i <= n; i++) {
            if (adj[i]) free(adj[i]);
        }
        free(adj);
        adj = NULL;
    }
    if (deg) {
        free(deg);
        deg = NULL;
    }
    n = 0;
    ok = 0;
}

/* ====== creeaza graf cu nn varfuri ====== */
void makeGraf(int nn) {
    int i;
    clearGraf();
    n = nn;

    adj = (int**)malloc((n + 1) * sizeof(int*));
    deg = (int*)malloc((n + 1) * sizeof(int));
    if (!adj || !deg) {
        printf("Eroare memorie.\n");
        exit(0);
    }

    for (i = 1; i <= n; i++) {
        adj[i] = NULL;
        deg[i] = 0;
    }
    ok = 1;
}

/* ====== verifica daca exista arc u->v ====== */
int hasEdge(int u, int v) {
    int k;
    if (!ok) return 0;
    if (u < 1 || u > n || v < 1 || v > n) return 0;
    for (k = 0; k < deg[u]; k++) if (adj[u][k] == v) return 1;
    return 0;
}

/* ====== adauga arc u->v (fara dublura) ====== */
void addEdge(int u, int v) {
    if (!ok) { printf("Nu exista graf.\n"); return; }
    if (u < 1 || u > n || v < 1 || v > n) { printf("Varf invalid.\n"); return; }
    if (hasEdge(u, v)) { printf("Arcul exista deja.\n"); return; }

    deg[u]++;
    adj[u] = (int*)realloc(adj[u], deg[u] * sizeof(int));
    if (!adj[u]) { printf("Eroare memorie.\n"); exit(0); }
    adj[u][deg[u] - 1] = v;
}

/* ====== sterge arc u->v daca exista ====== */
void delEdge(int u, int v) {
    int k, pos = -1, t;

    if (!ok) { printf("Nu exista graf.\n"); return; }
    if (u < 1 || u > n || v < 1 || v > n) { printf("Varf invalid.\n"); return; }

    for (k = 0; k < deg[u]; k++) if (adj[u][k] == v) { pos = k; break; }
    if (pos == -1) { printf("Arcul nu exista.\n"); return; }

    for (t = pos; t < deg[u] - 1; t++) adj[u][t] = adj[u][t + 1];
    deg[u]--;

    if (deg[u] == 0) { free(adj[u]); adj[u] = NULL; }
    else {
        adj[u] = (int*)realloc(adj[u], deg[u] * sizeof(int));
        if (!adj[u]) { printf("Eroare memorie.\n"); exit(0); }
    }
}

/* ================== INTRODUCERE ================== */

/* 1) lista adiacenta */
void inLista() {
    int nn, i, x;
    printf("n = "); scanf("%d", &nn);
    if (nn <= 0) { printf("n invalid.\n"); return; }
    makeGraf(nn);

    printf("Introdu vecinii fiecarui varf (0 stop). Varfuri 1..%d\n", n);
    for (i = 1; i <= n; i++) {
        printf("%d: ", i);
        while (1) {
            scanf("%d", &x);
            if (x == 0) break;
            if (x < 1 || x > n) { printf("(gresit) "); continue; }
            addEdge(i, x);
        }
    }
}

/* 2) matrice adiacenta */
void inMatrAdj() {
    int nn, i, j, x;
    printf("n = "); scanf("%d", &nn);
    if (nn <= 0) { printf("n invalid.\n"); return; }
    makeGraf(nn);

    printf("Introdu matricea A (%d x %d) cu 0/1:\n", n, n);
    for (i = 1; i <= n; i++) {
        for (j = 1; j <= n; j++) {
            scanf("%d", &x);
            if (x == 1) addEdge(i, j);
        }
    }
}

/* 3) matrice incidenta (accepta 0/1 cu doua 1 pe coloana; accepta si -1/+1) */
void inMatrInc() {
    int nn, m, i, col, x;
    int u, v, start, end;

    printf("n (varfuri) = "); scanf("%d", &nn);
    printf("m (arce/muchii) = "); scanf("%d", &m);
    if (nn <= 0 || m < 0) { printf("date invalide.\n"); return; }
    makeGraf(nn);

    printf("Introdu matricea B (%d x %d).\n", n, m);
    printf("Accept: 0/1 (doua de 1 pe coloana) sau -1/+1 (start=-1, end=+1)\n");

    for (col = 1; col <= m; col++) {
        u = 0; v = 0;
        start = 0; end = 0;

        for (i = 1; i <= n; i++) {
            scanf("%d", &x);

            if (x == -1) start = i;

            if (x == 1) {
                if (u == 0) u = i;
                else v = i;
                end = i;
            }
        }

        if (start != 0 && end != 0) addEdge(start, end);   /* varianta -1/+1 */
        else if (u != 0 && v != 0) addEdge(u, v);          /* varianta 0/1 */
        else printf("Coloana %d invalida (ignorata)\n", col);
    }
}

/* meniu introducere */
void introducere_graf() {
    int t;
    printf("\nIntroducere:\n1) Lista adiacenta\n2) Matrice adiacenta\n3) Matrice incidenta\nAlege: ");
    scanf("%d", &t);
    if (t == 1) inLista();
    else if (t == 2) inMatrAdj();
    else if (t == 3) inMatrInc();
    else printf("Optiune gresita.\n");
}

/* ================== AFISARE ================== */

void showLista() {
    int i, k;
    if (!ok) { printf("Nu exista graf.\n"); return; }
    for (i = 1; i <= n; i++) {
        printf("%d: ", i);
        for (k = 0; k < deg[i]; k++) printf("%d ", adj[i][k]);
        printf("\n");
    }
}

void showMatrAdj() {
    int i, j;
    if (!ok) { printf("Nu exista graf.\n"); return; }
    for (i = 1; i <= n; i++) {
        for (j = 1; j <= n; j++) printf("%d ", hasEdge(i, j));
        printf("\n");
    }
}

/* matrice incidenta 0/1: o coloana pentru fiecare arc (u->v): 1 la u si 1 la v */
void showMatrInc() {
    int i, u, v, k, m = 0, idx;

    if (!ok) { printf("Nu exista graf.\n"); return; }

    for (i = 1; i <= n; i++) m += deg[i];
    if (m == 0) { printf("Nu exista arce.\n"); return; }

    int *U = (int*)malloc((m + 1) * sizeof(int));
    int *V = (int*)malloc((m + 1) * sizeof(int));
    if (!U || !V) { printf("Eroare memorie.\n"); return; }

    idx = 1;
    for (u = 1; u <= n; u++) {
        for (k = 0; k < deg[u]; k++) {
            v = adj[u][k];
            U[idx] = u;
            V[idx] = v;
            idx++;
        }
    }

    for (i = 1; i <= n; i++) {
        for (idx = 1; idx <= m; idx++) {
            int val = (i == U[idx] || i == V[idx]) ? 1 : 0;
            printf("%d ", val);
        }
        printf("\n");
    }

    free(U);
    free(V);
}

void afisare_graf() {
    int t;
    printf("\nAfisare:\n1) Lista\n2) Matrice adiacenta\n3) Matrice incidenta\nAlege: ");
    scanf("%d", &t);
    if (t == 1) showLista();
    else if (t == 2) showMatrAdj();
    else if (t == 3) showMatrInc();
    else printf("Optiune gresita.\n");
}

/* ================== MODIFICARE ================== */

void addVarf() {
    if (!ok) { printf("Nu exista graf.\n"); return; }

    n++;
    adj = (int**)realloc(adj, (n + 1) * sizeof(int*));
    deg = (int*)realloc(deg, (n + 1) * sizeof(int));
    if (!adj || !deg) { printf("Eroare memorie.\n"); exit(0); }

    adj[n] = NULL;
    deg[n] = 0;
    printf("S-a adaugat varful %d.\n", n);
}

void delVarf() {
    int v, i, k, t;
    if (!ok) { printf("Nu exista graf.\n"); return; }

    printf("Varf de sters (1..%d): ", n);
    scanf("%d", &v);
    if (v < 1 || v > n) { printf("Varf invalid.\n"); return; }

    if (adj[v]) free(adj[v]);
    adj[v] = NULL;
    deg[v] = 0;

    /* sterge aparitiile lui v si scade vecinii > v */
    for (i = 1; i <= n; i++) {
        if (i == v) continue;

        k = 0;
        while (k < deg[i]) {
            if (adj[i][k] == v) {
                for (t = k; t < deg[i] - 1; t++) adj[i][t] = adj[i][t + 1];
                deg[i]--;
                continue;
            }
            k++;
        }

        if (deg[i] == 0) { free(adj[i]); adj[i] = NULL; }
        else {
            adj[i] = (int*)realloc(adj[i], deg[i] * sizeof(int));
            if (!adj[i]) { printf("Eroare memorie.\n"); exit(0); }
        }

        for (k = 0; k < deg[i]; k++) if (adj[i][k] > v) adj[i][k]--;
    }

    /* muta v+1..n la stanga */
    for (i = v; i < n; i++) {
        adj[i] = adj[i + 1];
        deg[i] = deg[i + 1];
    }

    n--;
    if (n == 0) { clearGraf(); printf("Nu mai exista graf.\n"); return; }

    adj = (int**)realloc(adj, (n + 1) * sizeof(int*));
    deg = (int*)realloc(deg, (n + 1) * sizeof(int));
    if (!adj || !deg) { printf("Eroare memorie.\n"); exit(0); }

    printf("Sters. Acum n = %d.\n", n);
}

void addArcMenu() {
    int u, v;
    if (!ok) { printf("Nu exista graf.\n"); return; }
    printf("u v (u->v): ");
    scanf("%d%d", &u, &v);
    addEdge(u, v);
}

void delArcMenu() {
    int u, v;
    if (!ok) { printf("Nu exista graf.\n"); return; }
    printf("u v (u->v) de sters: ");
    scanf("%d%d", &u, &v);
    delEdge(u, v);
}

void modificare_graf() {
    int o;
    printf("\nModificare:\n1) Adauga varf\n2) Sterge varf\n3) Adauga arc\n4) Sterge arc\n0) Inapoi\nAlege: ");
    scanf("%d", &o);

    if (o == 1) addVarf();
    else if (o == 2) delVarf();
    else if (o == 3) addArcMenu();
    else if (o == 4) delArcMenu();
}

/* ================== CONVERSIE ==================
   conversie = obtinerea formei cerute; aici doar afisam forma aleasa
*/
void conversie_graf() {
    afisare_graf();
}

/* ================== FISIER ==================
   salveaza si citeste lista adiacenta (varfuri de la 1)
   format:
   n
   1: 2 3
   2: 3
   3:
*/

void saveFile() {
    char name[100];
    FILE *f;
    int i, k;

    if (!ok) { printf("Nu exista graf.\n"); return; }

    printf("Nume fisier: ");
    scanf("%s", name);

    f = fopen(name, "w");
    if (!f) { printf("Nu pot deschide.\n"); return; }

    fprintf(f, "%d\n", n);
    for (i = 1; i <= n; i++) {
        fprintf(f, "%d:", i);
        for (k = 0; k < deg[i]; k++) fprintf(f, " %d", adj[i][k]);
        fprintf(f, "\n");
    }
    fclose(f);
    printf("Salvat.\n");
}

void loadFile() {
    char name[100];
    FILE *f;
    int nn, i, idx, x, ch;

    printf("Nume fisier: ");
    scanf("%s", name);

    f = fopen(name, "r");
    if (!f) { printf("Nu pot deschide.\n"); return; }

    if (fscanf(f, "%d", &nn) != 1 || nn <= 0) { printf("Fisier invalid.\n"); fclose(f); return; }
    makeGraf(nn);

    for (i = 1; i <= n; i++) {
        if (fscanf(f, "%d:", &idx) != 1) break;

        while (1) {
            ch = fgetc(f);
            if (ch == '\n' || ch == EOF) break;
            ungetc(ch, f);

            if (fscanf(f, "%d", &x) == 1) {
                if (x >= 1 && x <= n) addEdge(i, x);
            } else break;
        }
    }

    fclose(f);
    ok = 1;
    printf("Citit.\n");
}

/* ================== MAIN ================== */

int main() {
    int opt;

    while (1) {
        printf("\n=== MENIU ===\n");
        printf("1) Introducere graf\n");
        printf("2) Modificare graf\n");
        printf("3) Conversie (afiseaza forma dorita)\n");
        printf("4) Afisare graf\n");
        printf("5) Salvare in fisier (lista)\n");
        printf("6) Citire din fisier (lista)\n");
        printf("0) Iesire\n");
        printf("Optiune: ");
        if (scanf("%d", &opt) != 1) break;

        if (opt == 1) introducere_graf();
        else if (opt == 2) modificare_graf();
        else if (opt == 3) conversie_graf();
        else if (opt == 4) afisare_graf();
        else if (opt == 5) saveFile();
        else if (opt == 6) loadFile();
        else if (opt == 0) break;
        else printf("Optiune gresita.\n");
    }

    clearGraf();
    return 0;
}
 
